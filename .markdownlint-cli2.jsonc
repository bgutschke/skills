{
  // Respect .gitignore so node_modules/ and .claude/ (worktrees, plugin
  // caches) are never scanned.
  "gitignore": true,
  "config": {
    "default": true,
    // Prose in SKILL.md/README/doc files isn't hard-wrapped; enforcing a
    // fixed line length flags nearly every paragraph.
    "MD013": false,
    // Bare issue references ("#10 introduced...") at the start of a
    // paragraph are misread as ATX headings.
    "MD018": false,
    // skills/productivity/audit-rules/SKILL.md numbers steps
    // continuously across multiple H2 sections by design, not restarting
    // the count per list.
    "MD029": false,
    // Angle-bracket placeholders in prose (`<owner>/<repo>`, `<bot>`) are
    // this repo's literal convention, not real HTML.
    "MD033": false,
    // SKILL.md files use bold text as compact in-list section labels,
    // not as standalone headings.
    "MD036": false,
    // skills/engineering/to-pr/SKILL.md's `type(scope): ` code spans
    // include a trailing space on purpose, to show the literal prefix.
    "MD038": false,
    // AGENTS.md and the PR template deliberately open with prose or a
    // second-level heading, not an H1.
    "MD041": false,
    // Enforce per-file consistency rather than one fixed style repo-wide —
    // docs already differ on emphasis marker (asterisk vs. underscore).
    "MD049": { "style": "consistent" },
    // Same idea for table pipe padding — some tables here are padded for
    // readability, others aren't.
    "MD060": { "style": "consistent" }
  },
  // CHANGELOG.md is generated by semantic-release, not hand-authored.
  // CLAUDE.md is a symlink to AGENTS.md — linting it too would just
  // duplicate every finding.
  "ignores": ["CHANGELOG.md", "CLAUDE.md"]
}
